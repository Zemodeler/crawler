{
  "name": "universal-study-hub",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental false",
    "check": "corepack pnpm typecheck && corepack pnpm lint && corepack pnpm test && corepack pnpm build",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:build": "pnpm run build && node --test \"tests/*.test.mjs\"",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "host": "node host/index.mjs",
    "app": "electron shell/main.mjs",
    "app:selftest": "electron shell/main.mjs --selftest",
    "desktop:stage": "node build/desktop-release.mjs --stage-only",
    "desktop:win": "node build/desktop-release.mjs --win --build",
    "desktop:mac": "node build/desktop-release.mjs --mac --build",
    "desktop:test": "node --test tests/desktop-release.test.mjs tests/updates.test.mjs"
  },
  "dependencies": {
    "crawler": "link:..",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "electron": "^44.7.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
