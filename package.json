{
  "name": "crawler",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "description": "Syncs a university VLE into a Study Hub folder: files sorted by module, deadlines with their sources.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./electron": "./bin/electron-env.mjs",
    "./weeks": "./src/weeks.ts"
  },
  "scripts": {
    "check": "corepack pnpm typecheck && corepack pnpm test && corepack pnpm --dir hub check",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test \"test/**/*.test.ts\"",
    "crawler": "electron bin/crawler.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "^44.7.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "pdfjs-dist": "6.2.108"
  }
}
